{
  "name": "rpt-management",
  "version": "1.0.0",
  "description": "Real Property Tax Management System (BASIC + SEF)",
  "main": "main.js",
  "author": "Treasurer's Office",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "node-sqlite3-wasm": "^0.8.30"
  },
  "build": {
    "appId": "gov.lgu.rpt",
    "productName": "RPT Management",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/node-sqlite3-wasm/**"
    ],
    "files": [
      "main.js",
      "preload.js",
      "database.js",
      "report.js",
      "renderer/**/*",
      "node_modules/**/*",
      "build/icon.ico"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RPT Management"
    }
  }
}
